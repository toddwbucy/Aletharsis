{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "aletharsis.profile/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 64
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "text",
            "source",
            "html",
            "xml",
            "docx",
            "odt",
            "pdf"
          ]
        },
        "variant": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "parser": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "parser_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "maxLength": 64
        }
      },
      "required": [
        "format",
        "variant",
        "parser",
        "parser_version"
      ]
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
          },
          "revision": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "maxLength": 64
          },
          "kind": {
            "enum": [
              "unicode_character",
              "package_part",
              "relationship",
              "formatting",
              "text_object",
              "metadata_field",
              "embedded_object"
            ]
          },
          "facts": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 16,
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "producer": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
                  "maxLength": 64
                },
                "configuration_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "value",
                "producer",
                "version",
                "configuration_sha256"
              ]
            }
          },
          "assessment": {
            "enum": [
              "expected",
              "noteworthy",
              "suspicious",
              "unknown"
            ]
          },
          "queue": {
            "enum": [
              "omit_default",
              "retain"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "id",
          "revision",
          "kind",
          "facts",
          "assessment",
          "queue",
          "rationale"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "queue": {
                  "const": "omit_default"
                }
              }
            },
            "then": {
              "properties": {
                "assessment": {
                  "const": "expected"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "unicode_character"
                }
              }
            },
            "then": {
              "properties": {
                "facts": {
                  "required": [
                    "code_point",
                    "context"
                  ],
                  "properties": {
                    "code_point": {
                      "properties": {
                        "value": {
                          "pattern": "^U\\+[0-9A-F]{4,6}$"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "contract",
    "id",
    "version",
    "scope",
    "rules"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aletharsis.invalid/bundled/profile-v1.json"
}
