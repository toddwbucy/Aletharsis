{
  "type": "object",
  "properties": {
    "aletharsis_version": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "extension": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "identification_basis": {
          "type": "string"
        },
        "size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "parser": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "filename",
        "extension",
        "mime",
        "format",
        "identification_basis",
        "size",
        "sha256",
        "parser"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "completed",
        "failed"
      ]
    },
    "summary": {
      "type": "object",
      "properties": {
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "high": {
          "type": "integer",
          "minimum": 0
        },
        "medium": {
          "type": "integer",
          "minimum": 0
        },
        "low": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      },
      "required": [
        "findings",
        "high",
        "medium",
        "low",
        "info",
        "exit_code"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "texts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "encoding": {
                "type": "string"
              },
              "byte_offsets": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "bom": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "line_endings": {
                "type": "object",
                "properties": {
                  "crlf": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "lf": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cr": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "crlf",
                  "lf",
                  "cr"
                ],
                "additionalProperties": false
              },
              "hashes": {
                "type": "object",
                "properties": {
                  "raw_text_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "nfc_text_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "nfkc_text_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "formatting_removed_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "raw_text_sha256",
                  "nfc_text_sha256",
                  "nfkc_text_sha256",
                  "formatting_removed_sha256"
                ],
                "additionalProperties": false
              },
              "normalization": {
                "type": "object",
                "properties": {
                  "nfc_changed": {
                    "type": "boolean"
                  },
                  "nfkc_changed": {
                    "type": "boolean"
                  },
                  "formatting_removed_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "unicode_version": {
                    "type": "string"
                  },
                  "hash_encoding": {
                    "const": "utf-8"
                  },
                  "removal_policy": {
                    "type": "string"
                  }
                },
                "required": [
                  "nfc_changed",
                  "nfkc_changed",
                  "formatting_removed_count",
                  "unicode_version",
                  "hash_encoding",
                  "removal_policy"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "source",
              "text",
              "encoding",
              "byte_offsets",
              "bom",
              "line_endings",
              "hashes",
              "normalization"
            ],
            "additionalProperties": false
          }
        },
        "metadata": {
          "type": "object"
        },
        "structure": {
          "type": "object"
        }
      },
      "required": [
        "texts",
        "metadata",
        "structure"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "INFO",
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "category": {
            "enum": [
              "metadata",
              "unicode",
              "hidden_content",
              "document_structure",
              "embedded_content",
              "identifier",
              "visual_watermark",
              "possible_steganography",
              "provenance",
              "parser"
            ]
          },
          "classification": {
            "enum": [
              "observed_fact",
              "suspicious_pattern",
              "likely_mechanism",
              "undetermined"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "evidence": {
            "type": "object"
          },
          "location": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "severity",
          "confidence",
          "category",
          "classification",
          "title",
          "description",
          "evidence",
          "location"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "aletharsis_version",
    "schema_version",
    "file",
    "status",
    "summary",
    "evidence",
    "findings",
    "limitations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aletharsis report v1.0"
}
